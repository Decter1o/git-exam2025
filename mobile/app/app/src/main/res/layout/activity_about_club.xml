<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".AboutClub">


  <ImageView
      android:id="@+id/imageView17"
      android:layout_width="32sp"
      android:layout_height="30sp"
      android:onClick="BackProfile"
      android:src="@drawable/arrow"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.042"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.099"
      tools:ignore="OnClick,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

  <com.google.android.material.bottomnavigation.BottomNavigationView
      android:id="@+id/bottom_navigation"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/white"
      android:layout_marginBottom="10sp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.0"
      app:layout_constraintStart_toStartOf="parent"
      app:menu="@drawable/bottom_nav_menu"
      app:itemTextColor="@color/selector_bottom_nav"
      app:itemIconTint="@color/selector_bottom_nav"/>

  <FrameLayout
      android:id="@+id/frameLayout4"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:layout_constraintBottom_toBottomOf="@+id/bottom_navigation"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.0"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.090"
      tools:ignore="DuplicateIds">

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/montserrat_semibold"
        android:gravity="center"
        android:text="О Клубе"
        android:textColor="#CC000000"
        android:textSize="32sp"
        tools:ignore="DuplicateIds" />

  </FrameLayout>

  <FrameLayout
      android:layout_width="411sp"
      android:layout_height="wrap_content"
      android:background="#F3F4F6"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.49"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.239">

    <FrameLayout
        android:id="@+id/frameLayout4"
        android:layout_width="411sp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        tools:ignore="DuplicateIds">

      <TextView
          android:id="@+id/textView7"
          android:layout_width="wrap_content"
          android:layout_height="32dp"
          android:layout_gravity="center|start"
          android:layout_marginLeft="60sp"
          android:fontFamily="@font/montserrat_semibold"
          android:gravity="center"
          android:text="Режим работы: с 7:00 до 23:00"
          android:textColor="@color/black"
          android:textSize="16sp"
          tools:ignore="DuplicateIds" />

      <ImageView
          android:id="@+id/imageView16"
          android:layout_width="22sp"
          android:layout_height="22sp"
          android:layout_gravity="center|start"
          android:layout_marginLeft="20sp"
          app:srcCompat="@drawable/time" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="411sp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40sp"
        android:background="@color/white"
        tools:ignore="MissingConstraints">

      <TextView
          android:id="@+id/tv_phone"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center|start"
          android:layout_marginLeft="60sp"
          android:autoLink="phone"
          android:clickable="true"
          android:focusable="true"
          android:fontFamily="@font/montserrat_semibold"
          android:gravity="center"
          android:text="+7(707)6352020"
          android:textColor="@color/black"
          android:textColorLink="@color/black"
          android:textSize="18sp" />

      <ImageView
          android:id="@+id/imageView12"
          android:layout_width="25sp"
          android:layout_height="25sp"
          android:layout_gravity="center|start"
          android:layout_marginLeft="20sp"
          app:srcCompat="@drawable/phone" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout5"
        android:layout_width="411sp"
        android:layout_height="wrap_content"
        android:layout_marginTop="80sp"
        android:background="@color/white"
        tools:ignore="MissingConstraints">


      <TextView
          android:id="@+id/tv_email"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center|start"
          android:layout_marginLeft="60sp"
          android:autoLink="email"
          android:clickable="true"
          android:focusable="true"
          android:fontFamily="@font/montserrat_semibold"
          android:gravity="center"
          android:text="FitnessFamily@mail.ru"
          android:textColor="@color/black"
          android:textColorLink="@color/black"
          android:textSize="18sp" />

      <ImageView
          android:id="@+id/imageView13"
          android:layout_width="25sp"
          android:layout_height="25sp"
          android:layout_gravity="center|start"
          android:layout_marginLeft="20sp"
          app:srcCompat="@drawable/post" />
    </FrameLayout>
  </FrameLayout>

  <FrameLayout
      android:layout_width="411sp"
      android:layout_height="wrap_content"
      android:background="#E5E5E5"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.49"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.471">

    <FrameLayout
        android:id="@+id/frameLayout8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|top"
        android:background="@color/white"
        tools:ignore="MissingConstraints">


      <TextView
          android:id="@+id/textView7"
          android:layout_width="wrap_content"
          android:layout_height="32dp"
          android:layout_gravity="center"
          android:fontFamily="@font/montserrat_semibold"
          android:gravity="center"
          android:text="Адреса клубов:"
          android:textColor="@color/black"
          android:textSize="18sp"
          tools:ignore="DuplicateIds" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/white"
        tools:ignore="DuplicateIds">

      <TextView
          android:id="@+id/textView7"
          android:layout_width="411sp"
          android:layout_height="32dp"
          android:layout_marginLeft="60sp"
          android:layout_gravity="center"
          android:fontFamily="@font/montserrat_semibold"
          android:gravity="center|start"
          android:text="Fitness Family 3. Ж.Кизатова 3Е"
          android:textColor="@color/black"
          android:textSize="16sp"
          tools:ignore="DuplicateIds" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80sp"
        android:layout_gravity="center|top"
        android:background="@color/white"
        tools:ignore="MissingConstraints">


      <TextView
          android:id="@+id/textView7"
          android:layout_width="411sp"
          android:layout_marginLeft="60sp"
          android:layout_height="32dp"
          android:fontFamily="@font/montserrat_semibold"
          android:gravity="center|start"
          android:text="Fitness Family 4. Брусиловского 22"
          android:textColor="@color/black"
          android:textSize="16sp"
          tools:ignore="DuplicateIds" />
    </FrameLayout>

  </FrameLayout>

  <FrameLayout
      android:layout_width="411sp"
      android:layout_height="wrap_content"
      android:background="#DCDCDC"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="1.0"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.798">

    <FrameLayout
        android:id="@+id/frameLayout9"
        android:layout_width="411sp"
        android:layout_height="wrap_content"

        android:background="@color/white"
        tools:ignore="MissingConstraints">


      <TextView
          android:id="@+id/textView7"
          android:layout_width="wrap_content"
          android:layout_height="32dp"
          android:layout_gravity="center"
          android:fontFamily="@font/montserrat_semibold"
          android:gravity="center"
          android:text="Мы в соц. сетях"
          android:textColor="@color/black"
          android:textSize="18sp"
          tools:ignore="DuplicateIds" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout4"
        android:layout_width="411sp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50sp"
        android:background="@color/white"
        tools:ignore="DuplicateIds">

      <TextView
          android:id="@+id/textView7_instagram"
          android:layout_width="wrap_content"
          android:layout_height="32dp"
          android:layout_gravity="center|start"
          android:layout_marginLeft="60sp"
          android:fontFamily="@font/montserrat_semibold"
          android:gravity="center"
          android:text="Instagram"
          android:textColor="@color/black"
          android:textSize="16sp"
          tools:ignore="DuplicateIds" />

      <ImageView
          android:id="@+id/imageView23"
          android:layout_width="25sp"
          android:layout_height="25sp"
          android:layout_gravity="center|start"
          android:layout_marginLeft="20sp"
          app:srcCompat="@drawable/inst" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout11"
        android:layout_width="411sp"
        android:layout_height="wrap_content"
        android:layout_marginTop="100sp"
        android:background="@color/white"
        tools:ignore="MissingConstraints">


      <TextView
          android:id="@+id/textView8_whatsapp"
          android:layout_width="wrap_content"
          android:layout_height="32dp"
          android:layout_gravity="center|start"
          android:layout_marginLeft="60sp"
          android:fontFamily="@font/montserrat_semibold"
          android:gravity="center"
          android:text="Fitness Family 3. Whatsapp"
          android:textColor="@color/black"
          android:textSize="16sp"
          tools:ignore="DuplicateIds" />

      <ImageView
          android:id="@+id/imageView24"
          android:layout_width="25sp"
          android:layout_height="25sp"
          android:layout_gravity="center|start"
          android:layout_marginLeft="20sp"
          app:srcCompat="@drawable/whatsapp" />

    </FrameLayout>
    <FrameLayout
        android:id="@+id/frameLayout7"
        android:layout_width="411sp"
        android:layout_height="wrap_content"
        android:layout_marginTop="150sp"
        android:background="@color/white"
        tools:ignore="MissingConstraints">


      <TextView
          android:id="@+id/textView7_whatsapp"
          android:layout_width="wrap_content"
          android:layout_height="32dp"
          android:layout_gravity="center|start"
          android:layout_marginLeft="60sp"
          android:fontFamily="@font/montserrat_semibold"
          android:gravity="center"
          android:text="Fitness Family 4. Whatsapp"
          android:textColor="@color/black"
          android:textSize="16sp"
          tools:ignore="DuplicateIds" />

      <ImageView
          android:id="@+id/imageView25"
          android:layout_width="25sp"
          android:layout_height="25sp"
          android:layout_gravity="center|start"
          android:layout_marginLeft="20sp"
          app:srcCompat="@drawable/whatsapp" />

    </FrameLayout>
  </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
