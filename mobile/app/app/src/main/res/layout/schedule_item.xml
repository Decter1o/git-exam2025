<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8sp"
    app:cardCornerRadius="40sp"
    app:cardElevation="6sp">

    <LinearLayout
        android:id="@+id/schedule_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24sp"
        android:orientation="vertical">

        <!-- Название занятия -->
        <TextView
            android:id="@+id/scheduleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:text="Йога"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Имя инструктора -->
        <TextView
            android:id="@+id/scheduleInstructor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8sp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Иванова А.А."
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <!-- Локация -->
        <TextView
            android:id="@+id/scheduleLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4sp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Зал 1"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <!-- Время занятия (убран CardView, теперь просто TextView) -->
        <TextView
            android:id="@+id/scheduleTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12sp"
            android:fontFamily="@font/montserrat_bold"
            android:text="08:00 - 09:00"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
